      --name                        agent identifier / file name                            [string]
      --prompt                      system prompt content (bypasses LLM generation)         [string]
      --prompt-file, --prompt_file  path to file containing system prompt content (bypasses LLM
                                    generation)                                             [string]
      --path                        directory path to generate the agent file               [string]
      --description                 what the agent should do                                [string]
      --mode                        agent mode      [string] [choices: "all", "primary", "subagent"]
      --permissions, --tools        comma-separated list of permissions to allow (default: all).
                                    Available: "bash, read, edit, glob, grep, webfetch, task,
                                    todowrite, websearch, lsp, skill"                       [string]
      --provision                   comma-separated list of tools to provision (profile tool
                                    allowlist)                                              [string]
  -m, --model                       model to use in the format of provider/model            [string]
      --json                        output JSON                                            [boolean]
  -o, --output                      write creation result to output file path               [string]"
