exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode models --help 1`] = `
"lmplayer models [provider]

list all available models

Commands:
  lmplayer models list [provider]  list available models                               [aliases: ls]
  lmplayer models verify <model>   verify a model is known and available; exit non-zero with a
                                   reason if not
  lmplayer models test [provider]  probe each model with a tiny prompt and report which actually
                                   work end-to-end
  lmplayer models show <model>     show detailed information for a specific model     [aliases: get]

Positionals:
  provider  provider ID to filter models by                                                 [string]

Options:
  -h, --help                       show help                                               [boolean]
  -v, --version                    show version number                                     [boolean]
      --print-logs                 print logs to stderr                                    [boolean]
      --log-level                  log level    [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                       run without external plugins                            [boolean]
  -q, --search, --query            filter models by query matching ID, name, or provider    [string]
  -r, --reasoning                  filter models supporting reasoning effort / thinking    [boolean]
      --toolcall, --tools          filter models supporting tool calling                   [boolean]
      --attachment, --attachments  filter models supporting image and file attachments     [boolean]
      --min-context                filter models with context window at least this many tokens
                                                                                            [number]
  -o, --output                     write models list to output file path                    [string]
      --verbose                    use more verbose model output (includes metadata like costs)
                                                                                           [boolean]
      --json                       output models as a JSON array (id, limits, capabilities,
                                   reasoning-effort variants)                              [boolean]
      --refresh                    refresh the models cache from models.dev                [boolean]
      --test                       probe each model with a tiny prompt and report which actually
                                   work end-to-end                                         [boolean]
      --timeout                    per-model timeout in milliseconds when using --test
                                                                           [number] [default: 60000]
      --concurrency                number of models to probe in parallel when using --test (default
                                   1, sequential)                              [number] [default: 1]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode stats --help 1`] = `
"lmplayer stats

show token usage and cost statistics

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --days          show stats for the last N days (default: all time)                    [number]
      --tools         number of tools to show (default: all)                                [number]
      --models        show model statistics (default: hidden). Pass a number to show top N,
                      otherwise shows all
      --project       filter by project (default: all projects, empty string: current project)
                                                                                            [string]
      --provider      filter by provider ID (e.g. ollama-cloud, deepseek)                   [string]
      --model         filter by model ID or provider/model (e.g. deepseek-v4.1-flash,
                      kimi-k2.7-code)                                                       [string]
      --budget        budget limit in USD to compare spend against (e.g. 10.00)             [number]
      --budget-check  exit with code 2 if total spend exceeds budget limit                 [boolean]
  -o, --output        write statistics to output file path                                  [string]
      --json          output as JSON                                                       [boolean]"
`;

