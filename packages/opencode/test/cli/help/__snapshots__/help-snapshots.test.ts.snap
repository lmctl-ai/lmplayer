exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode session --help 1`] = `
"lmplayer session

manage sessions

Commands:
  lmplayer session ls                                 list sessions
  lmplayer session show <sessionID>                   show detailed session information
                                                                                      [aliases: get]
  lmplayer session status [sessionID]                 show runtime status of sessions
  lmplayer session tail <sessionID>                   print recent session messages
  lmplayer session report <sessionID>                 report session metrics
  lmplayer session metrics <sessionID>                report machine-queryable session metrics
                                                      (tokens, cost, latency, tools, files)
  lmplayer session health <sessionID>                 report session context health
  lmplayer session list                               list sessions
  lmplayer session delete <sessionID>                 delete one or more sessions
  [extraSessionIDs..]                                                                  [aliases: rm]
  lmplayer session rename <sessionID> <title>         rename a session
  lmplayer session fork <sessionID>                   fork a session
  lmplayer session share <sessionID>                  share a session (create a public share link)
  lmplayer session unshare <sessionID>                unshare a session (revoke public share link)
  lmplayer session compact <sessionID>                compact/summarize a session
                                                                                [aliases: summarize]
  lmplayer session jobs <sessionID>                   inspect background jobs for a session
  lmplayer session crons <sessionID>                  inspect scheduled cron jobs for a session
  lmplayer session todo <sessionID>                   list todo tasks for a session
  lmplayer session diff <sessionID>                   show file diffs for a session
  lmplayer session export [sessionID]                 export session data as JSON
  lmplayer session import <file>                      import session data from JSON file or URL
  lmplayer session memory <sessionID>                 view or update durable memory for a session
                                                                                    [aliases: brain]

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

