{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "github-copilot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Copilot",
      "options": {
        "baseURL": "https://api.githubcopilot.com"
      },
      "models": {
        "gpt-4.1": {
          "name": "GPT-4.1"
        },
        "gpt-4.1-2025-04-14": {
