        "gpt-4o-mini-2024-07-18": {
          "name": "GPT-4o mini (2024-07-18)"
        },
        "gpt-5-mini": {
          "name": "GPT-5 mini",
          "reasoning": true,
          "provider": {
            "npm": "@ai-sdk/github-copilot"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        },
